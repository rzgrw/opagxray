# Isolated experiment only. No source, hook, or test in default production builds.
option(XRAY_OVERHEAD_PROBE "Build experimental common frame-overhead reference" OFF)
if(XRAY_OVERHEAD_PROBE)
    if(NOT APPLE)
        message(FATAL_ERROR "Reference experiment is currently macOS only")
    endif()
    if(NOT XRAY_OVERHEAD_ROLE MATCHES "^(base|off|on)$")
        message(FATAL_ERROR "Set XRAY_OVERHEAD_ROLE to base, off or on")
    endif()
    foreach(source OverheadProbe.h OverheadProbe.cpp OverheadExperiment.h OverheadExperiment.cpp)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${source}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/tools/prepare_overhead_identity.py")
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/prepare_overhead_identity.py"
        --source "${CMAKE_SOURCE_DIR}" --out "${CMAKE_CURRENT_BINARY_DIR}/overhead" --role "${XRAY_OVERHEAD_ROLE}"
        RESULT_VARIABLE identity_result)
    if(NOT identity_result EQUAL 0)
        message(FATAL_ERROR "Could not prepare experimental source identity")
    endif()
    target_compile_definitions(xrEngine PRIVATE XRAY_OVERHEAD_PROBE=1)
    target_include_directories(xrEngine PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/overhead")
    target_sources(xrEngine PRIVATE OverheadProbe.cpp OverheadExperiment.cpp)
    # Do not mix the portable core with the engine precompiled header/unity TU.
    set_source_files_properties(OverheadProbe.cpp PROPERTIES SKIP_PRECOMPILE_HEADERS ON SKIP_UNITY_BUILD_INCLUSION ON)
    add_executable(xrOverheadProbeTests EXCLUDE_FROM_ALL OverheadProbe.cpp tests/OverheadProbeTests.cpp)
    target_include_directories(xrOverheadProbeTests PRIVATE "${CMAKE_SOURCE_DIR}/src")
    target_compile_options(xrOverheadProbeTests PRIVATE -UNDEBUG -fno-exceptions)
    set_target_properties(xrOverheadProbeTests PROPERTIES UNITY_BUILD OFF)
    if(NOT XRAY_OVERHEAD_ROLE STREQUAL "base")
        add_executable(xrOverheadCollectorTests EXCLUDE_FROM_ALL FrameTimeCollector.cpp FrameTimeSession.cpp tests/OverheadCollectorTests.cpp)
        target_compile_definitions(xrOverheadCollectorTests PRIVATE XRAY_OVERHEAD_PROBE=1)
        target_include_directories(xrOverheadCollectorTests PRIVATE "${CMAKE_SOURCE_DIR}/src")
        target_compile_options(xrOverheadCollectorTests PRIVATE -UNDEBUG -fno-exceptions)
        set_target_properties(xrOverheadCollectorTests PROPERTIES UNITY_BUILD OFF)
    endif()
endif()
