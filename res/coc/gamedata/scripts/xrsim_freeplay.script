--[[
xrsim_freeplay.script - CoC 1.4.22 adapter for the engine's freeplay population AI.

Launch flag: -xrsim_freeplay recorded|live. Without it this script registers nothing.

The engine (ai.freeplay.* verbs, reached through xrsim_verb) owns one AI decision owner per
squad or squadless stalker/mutant. This script feeds it: a population snapshot every SYNC_MS,
observations when an owner wakes, and events (arrived, blocked, casualty, sighting).

It carries objectives out at the one point where stock chooses a destination: while active it
wraps simulation_board:get_squad_target (sim_board.script), which stock generic_update
(sim_squad_scripted.script) calls when a squad needs a new target. For a squad it holds (writer
"sim", enrolled, with an objective) the wrapper returns the objective's smart, provided the
smart passes stock's own keep-target check; every other call goes to the stock function
unchanged. When the objective's smart is missing or refused, the wrapper reports blocked and falls
back to the squad's assigned smart; when the smart it would answer fails stock's keep-target check,
it reports blocked and answers nil (blocked events: at most one per objective revision). Two cases
get nil without an event of their own: a hold whose squad has no assigned smart (no event at all), and
a fallback after a blocked objective when the squad has no assigned smart (the event for the
objective's site was already sent; no second one follows). After a nil answer stock's no-target path
locks the squad in place until a new revision. The adapter never sets
scripted_target, so stock population counts, tasks and reach rules see these squads as ordinary
simulation squads. Squad state it writes: a one-time reset (current_action, __lock) when a new
objective revision arrives, so that stock asks for a target at the squad's next update even
mid-travel, and on deactivation the clearing of __lock on the squads its nil answers left locked.
Deactivation restores the stock function; squads finish their current travel and return to stock
selection. It does not undo targets stock assigned while the adapter was active.
Companions, hostages, scripted and random-target squads are reported and left alone.
The player sees one on-screen line when the mode starts (provider, model, decision budget) or is refused
(what to do), and one per distinct provider failure the engine reports (last_failure in the mode reply).
--]]

local TICK_MS = 1000
local SYNC_MS = 5000
local LONE_SCAN_MS = 60000         -- a squadless scan pass starts this often
local SCAN_IDS_PER_TICK = 2048     -- ids per tick: a pass over 65534 ids takes 32 ticks, well within LONE_SCAN_MS
local FORCED_SYNC_GAP_MS = 2000    -- a death-forced sync runs no sooner than this after the previous sync
local REFUSAL_LOG_MS = 60000       -- a refused sync is logged at most once per this interval after the first
local MAX_SITES = 8
local MAX_SIGHTINGS = 6
local SIGHT_RADIUS_M = 150
local SIGHT_EXIT_RADIUS_M = 225
local SIGHT_COOLDOWN_MS = 300000

local NO_GROUP = 65535
local PROPS_KINDS = {"base", "territory", "lair", "resource"}

local mode                 -- launch mode, set in on_game_start
local verb_fn              -- the engine's xrsim_verb
local active = false       -- mode accepted and population begun
local failed = false       -- a Lua error or a refused mode switched the adapter off for the session
local registered = {}      -- [callback name] = registered function

local next_tick = 0
local next_sync = 0
local next_scan = 0
local last_sync = 0
local force_sync = false
local first_sync_done = false
local scan_cursor          -- next id of the squadless scan pass in progress, nil between passes
local scan_found = {}      -- ids found so far by the pass in progress
local refusals = 0         -- refused syncs since the last refusal line
local refusal_logged_at    -- time of the last refusal line

local lone_cache = {}      -- list of object ids found by the last complete squadless scan
local objectives = {}      -- [group id] = {owner, rev, verb, site, no_arrival, blocked_rev, arrived_rev, reset_rev}
local script_picks = {}    -- [group id] = {at, script}: the squad's condlist pick at time_global() `at`
local enrolled = {}        -- [group id] = writer reported in the last sync
local board_class          -- sim_board.simulation_board while the wrapper is installed
local stock_target_fn      -- the stock simulation_board.get_squad_target
local wrapper_fn           -- the installed wrapper
local held_locks = {}      -- [group id] = true when the wrapper answered nil (stock then set __lock)
local sight_pairs = {}     -- [observer id] = {[other id] = {armed, fired}} for damped sighting events
local warned = {}          -- [key] = true once a warning was logged
local failures_shown = {}  -- [last_failure value] = true once its message was shown this session

------------------------------------------------------------------------------------------------
-- helpers
------------------------------------------------------------------------------------------------

-- CoC's printf writes through the engine's Lua log, which drops every line unless the console
-- has "lua_debug on". The adapter's own lines must always reach the log (an adapter error is
-- otherwise invisible), so they go through log1 (Msg) when the engine has it, else printf.
local function emit(line)
	local log_line = rawget(_G, "log1")
	if type(log_line) == "function" then
		log_line(line)
	else
		printf("%s", line)
	end
end

local function log_info(text)
	emit("xrsim_freeplay: " .. text)
end

local function warn_once(key, text)
	if warned[key] then
		return
	end
	warned[key] = true
	emit("~ xrsim_freeplay: " .. text)
end

local function call(verb, payload)
	local ok, text = verb_fn(verb, payload or "")
	return ok, text or ""
end

local function round(x)
	return math.floor(x + 0.5)
end

local function level_id_of_vertex(gvid)
	local gg = game_graph()
	if not (gvid and gg:valid_vertex_id(gvid)) then
		return nil
	end
	return gg:vertex(gvid):level_id()
end

local function level_name_of_vertex(gvid)
	local level_id = level_id_of_vertex(gvid)
	return level_id and alife():level_name(level_id)
end

local function smart_name(smart_id)
	local entry = smart_id and SIMBOARD.smarts[smart_id]
	return entry and entry.smrt and entry.smrt:name()
end

local function species_of_clsid(cls)
	if IsStalker(nil, cls) then
		return "stalker"
	elseif IsMonster(nil, cls) then
		return "mutant"
	end
	return nil
end

-- nil for a faction game_relations does not know: asking it about one is a fatal engine assert.
local function community_of_squad(squad)
	return squad_community_by_behaviour[squad.player_id]
end

-- Relation between two groups. Mutants have no community entry in game_relations, so a mutant
-- is an enemy of every stalker and neutral to other mutants; stalkers use game_relations.
local function relation_between(species_a, community_a, species_b, community_b)
	if species_a == "mutant" or species_b == "mutant" then
		return species_a == species_b and "neutral" or "enemy"
	end
	if community_a == nil or community_b == nil then
		return "neutral"
	end
	if game_relations.is_factions_enemies(community_a, community_b) then
		return "enemy"
	elseif game_relations.is_factions_friends(community_a, community_b) then
		return "friend"
	end
	return "neutral"
end

local function precondition(smart, squad)
	local ok, result = pcall(smart.target_precondition, smart, squad)
	return ok and result == true
end

-- False when the smart cannot be a useful target, checked without calling stock
-- se_smart_terrain:target_precondition(squad) (smart_terrain.script). A disabled smart: target_precondition
-- does not check `disabled`, but stock's evaluate_prior scores a disabled smart 0, so stock never picks it.
-- Otherwise only where target_precondition is false for certain: respawn_only_smart, a full smart
-- (population >= max_population), a smart with no props, or props that name the squad's faction with a
-- non-positive weight while props.all is not positive. Anything it cannot decide (an odd value type) is
-- left to the precondition itself, so apart from disabled smarts a site list filtered with it equals the
-- list the precondition alone gives.
local function may_accept(smart, entry, squad)
	if smart.disabled or smart.respawn_only_smart == true then
		return false
	end
	local population, max_population = entry.population, smart.max_population
	if type(population) == "number" and type(max_population) == "number" and population >= max_population then
		return false
	end
	local props = smart.props
	if not props then
		return false
	end
	local own, all = props[squad.player_id], props.all
	if type(own) == "number" and type(all) == "number" and own <= 0 and all <= 0 then
		return false
	end
	return true
end

local function site_kind(smart)
	local props = smart.props
	if props then
		for i = 1, #PROPS_KINDS do
			local value = props[PROPS_KINDS[i]]
			if value and value > 0 then
				return PROPS_KINDS[i]
			end
		end
	end
	return "site"
end

-- Living members of a squad as {id, section, leader}, plus the squad's species.
local function living_members(squad)
	local members = {}
	local species
	local commander = squad:commander_id()
	local sim = alife()
	for k in squad:squad_members() do
		local se_obj = k.object or (k.id and sim:object(k.id))
		if se_obj and se_obj.alive and se_obj:alive() then
			local member_species = species_of_clsid(se_obj:clsid())
			if member_species then
				if species == nil or k.id == commander then
					species = member_species
				end
				members[#members + 1] = {id = k.id, section = se_obj:section_name(), leader = k.id == commander}
			end
		end
	end
	return members, species
end

------------------------------------------------------------------------------------------------
-- messages for the player (global so the CoC namespace and tests can reach them; they read only their arguments)
------------------------------------------------------------------------------------------------

local PROVIDER_WORDS = {claude_cli = "Claude subscription via Claude Code", anthropic = "Anthropic API"}

-- The on-screen line for an accepted mode, from the ai.freeplay.mode reply
-- ("mode=live provider=<p> model=<m> max_in_flight=<n> calls_per_minute=<n> ...").
function activation_message(reply)
	local mode_name = string.match(reply or "", "^mode=(%S+)")
	if mode_name ~= "live" then
		return "AI freeplay is on in recorded mode (no model)"
	end
	local provider = string.match(reply, " provider=(%S+)") or "?"
	local model = string.match(reply, " model=(%S+)") or "?"
	local calls = tonumber(string.match(reply, " calls_per_minute=(%d+)") or "")
	local budget = (calls == nil or calls == 0) and "no limit on decisions per minute" or
		"up to " .. calls .. " decisions per minute"
	return "AI freeplay is on: " .. (PROVIDER_WORDS[provider] or provider) .. ", model " .. model .. ", " .. budget
end

-- What to do when the engine refuses the mode, keyed by its reason.
function refusal_message(reason)
	reason = reason or ""
	local name = string.match(reason, "^invalid_setting:(%S+)")
	if name then
		return "AI freeplay is off: the setting " .. name .. " has a value out of range. Fix it or unset it."
	elseif reason == "cli_unavailable" then
		return "AI freeplay is off: Claude Code was not found. Install it, sign in by running `claude`, then start the game again."
	elseif reason == "missing_api_key" then
		return "AI freeplay is off: XRAY_AGENT_PROVIDER is anthropic but no Anthropic API key is set. Set " ..
			"ANTHROPIC_API_KEY, or unset XRAY_AGENT_PROVIDER to play on your Claude subscription, then start the game again."
	elseif reason == "missing_model" then
		return "AI freeplay is off: no model is set for the Anthropic API. Set XRAY_AGENT_MODEL to a model name, " ..
			"then start the game again."
	elseif reason == "unsupported_platform" then
		return "AI freeplay is off: playing on the Claude subscription through Claude Code is not supported on this " ..
			"system yet (macOS and Linux only)."
	elseif reason == "invalid_model" then
		return "AI freeplay is off: the model name (XRAY_AGENT_MODEL) must be one word."
	elseif reason == "provider_disabled" then
		return "AI freeplay is off: XRAY_AGENT_PROVIDER names no provider it knows (claude_cli or anthropic)."
	elseif reason == "invalid_cli" then
		return "AI freeplay is off: the Claude Code path (XRAY_AGENT_CLI) must be one word."
	end
	return "AI freeplay is off: " .. reason
end

-- What a provider failure means for the player; the Zone carries on and the engine retries.
function failure_message(reason)
	if reason == "cli_exit" then
		return "Claude Code could not answer. Run `claude` in a terminal to check that you are signed in."
	elseif reason == "cli_timeout" then
		return "Claude Code is not answering in time. The Zone carries on; it will try again."
	elseif reason == "cli_unavailable" then
		return "Claude Code was not found. Install it and sign in by running `claude`."
	elseif reason == "transport_error" or reason == "http_status" then
		return "The Anthropic API could not be reached. The Zone carries on; it will try again."
	end
	return "The AI provider failed (" .. tostring(reason) .. "). The Zone carries on; it will try again."
end

-- The message for a new last_failure in a mode reply, once per distinct value per session; nil otherwise.
function failure_notice(reply, shown)
	local reason = string.match(reply or "", " last_failure=(%S+)")
	if not reason or shown[reason] then
		return nil
	end
	shown[reason] = true
	return failure_message(reason), reason
end

------------------------------------------------------------------------------------------------
-- writers
------------------------------------------------------------------------------------------------

-- True when the squad's own condlist picks a scripted target. Stock evaluates that condlist at every
-- update of the squad (sim_squad_scripted:get_script_target); the adapter reuses its own pick when it
-- is at most max_age_ms old (0: made in this same frame) instead of evaluating the condlist again.
local function condlist_scripted(squad, max_age_ms)
	local now = time_global()
	local cached = script_picks[squad.id]
	if cached and cached.at <= now and now - cached.at <= max_age_ms then
		return cached.script
	end
	local section = xr_logic.pick_section_from_condlist(db.actor, squad, squad.action_condlist)
	local script = section ~= nil and section ~= "" and section ~= "nil"
	if cached then
		cached.at, cached.script = now, script
	else
		script_picks[squad.id] = {at = now, script = script}
	end
	return script
end

-- max_age_ms: how old a condlist pick may be reused (see condlist_scripted); 0 when omitted.
local function writer_of(squad, max_age_ms)
	local id = squad.id
	if axr_companions.companion_squads[id] then
		return "companion"
	end
	local commander = squad:commander_id()
	if commander and xrs_kill_wounded.hostage_list[commander] then
		return "hostage"
	end
	if squad.scripted_target ~= nil then
		return "script"
	end
	if squad.action_condlist and condlist_scripted(squad, max_age_ms or 0) then
		return "script"
	end
	if squad.random_targets then
		return "random"
	end
	return "sim"
end

-- True when the adapter carries this squad's objective out: it has an objective, the last sync
-- enrolled it as sim, and it is still sim now. A squad that stops being sim keeps its objective,
-- so it resumes it if it is sim again later (the engine sends apply only on a new revision).
local function holds(squad)
	local id = squad.id
	return objectives[id] ~= nil and enrolled[id] == "sim" and writer_of(squad) == "sim"
end

local function is_hold(objective)
	return objective.verb == "hold" or objective.site == "-"
end

-- True when stock has the squad staying at the named smart (current_action 1 is stock's stay action).
local function stays_at(squad, site)
	local smart = SIMBOARD.smarts_by_names[site]
	return smart ~= nil and squad.current_action == 1 and squad.current_target_id == smart.id
end

-- Stock's own test for keeping a target (generic_update re-validates the assigned target with it):
-- props, surge and time windows apply, population does not.
local function keeps(smart, squad)
	local ok, result = pcall(smart.target_precondition, smart, squad, true)
	return ok and result == true
end

local function send_blocked(squad, objective, name)
	if objective.blocked_rev ~= objective.rev then
		objective.blocked_rev = objective.rev
		call("ai.freeplay.event", squad.id .. " blocked " .. name)
	end
end

-- The smart a held squad should target, chosen when stock asks for a target.
-- * A site objective gives its smart. move_to and retreat to a smart the squad is not assigned
--   to also need the full stock precondition (population included). A missing or refusing smart
--   is blocked and the objective falls back to a hold. stay asks no precondition here.
-- * A hold keeps the squad's assigned smart.
-- * Any smart returned must pass keeps(); stock would otherwise drop it at every update and ask
--   again. If it fails, or there is no smart, the answer is nil: stock runs its no-target path
--   and locks the squad in place until a new revision (the owner holds position and retries).
-- Blocked events: at most one per objective revision.
local function objective_target(squad, objective)
	local smart, name
	if not is_hold(objective) then
		name = objective.site
		smart = SIMBOARD.smarts_by_names[name]
		if smart == nil or (objective.verb ~= "stay" and smart.id ~= squad.smart_id and
			not precondition(smart, squad)) then
			send_blocked(squad, objective, name)
			smart = nil
		end
	end
	if smart == nil then
		local entry = squad.smart_id and SIMBOARD.smarts[squad.smart_id]
		smart = entry and entry.smrt
		name = smart and smart:name()
	end
	if smart and not keeps(smart, squad) then
		send_blocked(squad, objective, name)
		smart = nil
	end
	if smart == nil then
		held_locks[squad.id] = true
	end
	return smart
end

------------------------------------------------------------------------------------------------
-- population sync
------------------------------------------------------------------------------------------------

-- Squadless stalkers and mutants: server object ids from..to that are alive and have no squad.
local function scan_ids(from, to, found)
	local sim = alife()
	for id = from, to do
		local se_obj = sim:object(id)
		if se_obj and se_obj.group_id == NO_GROUP and species_of_clsid(se_obj:clsid()) and se_obj:alive() then
			found[#found + 1] = id
		end
	end
end

-- One whole pass at once: used only at activation, so the first sync's census is complete.
local function scan_lone_full(now)
	local found = {}
	scan_ids(1, NO_GROUP - 1, found)
	lone_cache = found
	scan_cursor = nil
	scan_found = {}
	next_scan = now + LONE_SCAN_MS
end

-- The periodic pass, spread over ticks: a pass starts every LONE_SCAN_MS and looks at
-- SCAN_IDS_PER_TICK ids per tick; lone_cache keeps the last complete pass until the next one ends.
local function scan_lone_step(now)
	if scan_cursor == nil then
		if now < next_scan then
			return
		end
		scan_cursor = 1
		scan_found = {}
		next_scan = now + LONE_SCAN_MS
	end
	local last = math.min(scan_cursor + SCAN_IDS_PER_TICK - 1, NO_GROUP - 1)
	scan_ids(scan_cursor, last, scan_found)
	if last >= NO_GROUP - 1 then
		lone_cache = scan_found
		scan_found = {}
		scan_cursor = nil
	else
		scan_cursor = last + 1
	end
end

-- Squad description used by sync and observations. nil for a squad that is not reported.
local function describe(squad)
	if squad.disabled then
		return nil
	end
	local members, species = living_members(squad)
	if #members == 0 or species == nil then
		return nil
	end
	local level = level_name_of_vertex(squad.m_game_vertex_id)
	if not level then
		return nil
	end
	return {
		squad = squad,
		members = members,
		species = species,
		level = level,
		level_id = level_id_of_vertex(squad.m_game_vertex_id),
		community = community_of_squad(squad),
	}
end

-- Sighting events, damped. A pair (observer, other) fires when a hostile squad comes within
-- SIGHT_RADIUS_M of an observer the model can act on (writer sim) on the actor's level; it re-arms only after the
-- two were farther apart than SIGHT_EXIT_RADIUS_M at a sync, and never fires again within
-- SIGHT_COOLDOWN_MS. The first sync is a baseline. Pair state is dropped as soon as either
-- squad leaves the snapshot, stops being sim (observer), or the entry carries no information.
local function update_sightings(groups, now)
	local by_level = {}
	local present = {}
	for i = 1, #groups do
		local group = groups[i]
		present[group.squad.id] = group.level_id
		local list = by_level[group.level_id]
		if not list then
			list = {}
			by_level[group.level_id] = list
		end
		list[#list + 1] = group
	end

	-- Only the actor's level: what the player can check, and online squads with real positions.
	local se_actor = alife():actor()
	local actor_level = se_actor and level_id_of_vertex(se_actor.m_game_vertex_id)
	local events = {}
	for level_id, list in pairs(by_level) do
		for i = 1, #list do
			local a = list[i]
			local a_id = a.squad.id
			if enrolled[a_id] == "sim" and level_id == actor_level then
				local pairs_of_a = sight_pairs[a_id]
				for j = 1, #list do
					local b = list[j]
					if i ~= j then
						local b_id = b.squad.id
						local state = pairs_of_a and pairs_of_a[b_id]
						local distance = a.squad.position:distance_to(b.squad.position)
						if distance <= SIGHT_RADIUS_M then
							if (state == nil or state.armed) and
								relation_between(a.species, a.community, b.species, b.community) == "enemy" then
								local cooling = state and state.fired and now - state.fired < SIGHT_COOLDOWN_MS
								if not first_sync_done then
									state = {armed = false}
								elseif not cooling then
									events[#events + 1] = a_id .. " sighting " .. b.squad:name()
									state = {armed = false, fired = now}
								end
								if state then
									pairs_of_a = pairs_of_a or {}
									sight_pairs[a_id] = pairs_of_a
									pairs_of_a[b_id] = state
								end
							end
						elseif state and distance > SIGHT_EXIT_RADIUS_M then
							state.armed = true
						end
					end
				end
			end
		end
	end

	for a_id, pairs_of_a in pairs(sight_pairs) do
		if not present[a_id] or enrolled[a_id] ~= "sim" or present[a_id] ~= actor_level then
			sight_pairs[a_id] = nil
		else
			for b_id, state in pairs(pairs_of_a) do
				local expired = state.armed and (state.fired == nil or now - state.fired >= SIGHT_COOLDOWN_MS)
				if not present[b_id] or expired then
					pairs_of_a[b_id] = nil
				end
			end
			if next(pairs_of_a) == nil then
				sight_pairs[a_id] = nil
			end
		end
	end

	for i = 1, #events do
		call("ai.freeplay.event", events[i])
	end
end

-- A refused sync changes nothing in the engine (a snapshot is taken whole or not at all). The first
-- refusal is logged with its reason, then at most one line per REFUSAL_LOG_MS with the count since the
-- last line, so a refusal that persists stays visible.
local function note_refused_sync(now, reason)
	refusals = refusals + 1
	if refusal_logged_at ~= nil and now - refusal_logged_at < REFUSAL_LOG_MS then
		return
	end
	if refusal_logged_at == nil then
		emit("~ xrsim_freeplay: sync refused: " .. reason)
	else
		emit(string.format("~ xrsim_freeplay: sync refused: %s (%d refusals since the last line)", reason, refusals))
	end
	refusal_logged_at = now
	refusals = 0
end

local function sync(now)
	next_sync = now + SYNC_MS
	last_sync = now
	force_sync = false

	local lines = {"xrsim_freeplay_sync_v1"}
	local groups = {}
	local in_group = {}
	local now_enrolled = {}
	for id, squad in pairs(SIMBOARD.squads) do
		local group = describe(squad)
		if group then
			local writer = writer_of(squad, SYNC_MS)
			now_enrolled[id] = writer
			groups[#groups + 1] = group
			lines[#lines + 1] = string.format("group %d %s %s %s %s %s %s %s %d", id, squad:name(), group.species,
				squad.player_id, group.level, smart_name(squad.smart_id) or "-",
				smart_name(squad.assigned_target_id or squad.current_target_id) or "-", writer, squad.online and 1 or 0)
			for i = 1, #group.members do
				local member = group.members[i]
				in_group[member.id] = true
				lines[#lines + 1] = string.format("member %d %d %s %d", id, member.id, member.section,
					member.leader and 1 or 0)
			end
		end
	end
	for id in pairs(enrolled) do
		if now_enrolled[id] == nil then
			objectives[id] = nil
			held_locks[id] = nil
		end
	end
	for id in pairs(script_picks) do
		if now_enrolled[id] == nil then
			script_picks[id] = nil
		end
	end
	enrolled = now_enrolled

	local sim = alife()
	local lone = 0
	for i = 1, #lone_cache do
		local id = lone_cache[i]
		local se_obj = not in_group[id] and sim:object(id)
		if se_obj and se_obj.group_id == NO_GROUP and se_obj:alive() then
			local species = species_of_clsid(se_obj:clsid())
			local level = level_name_of_vertex(se_obj.m_game_vertex_id)
			if species and level then
				lone = lone + 1
				lines[#lines + 1] = string.format("npc %d %s %s %s %s", id, se_obj:section_name(), species,
					alife_character_community(se_obj) or "-", level)
			end
		end
	end
	lines[#lines + 1] = "end"

	local ok, text = call("ai.freeplay.sync", table.concat(lines, "\n"))
	if not ok then
		note_refused_sync(now, text)
		return
	end
	if not first_sync_done then
		log_info(string.format("synced %s groups=%d lone=%d", text, #groups, lone))
	end
	update_sightings(groups, now)
	first_sync_done = true
end

------------------------------------------------------------------------------------------------
-- observations
------------------------------------------------------------------------------------------------

local function observe(owner_id, group_id, membership_revision)
	local squad = SIMBOARD.squads[group_id]
	local group = squad and describe(squad)
	if not group then
		return   -- gone since the last sync; the engine times the wake out
	end

	-- Sites: the squad's current smart first, then the smarts on any level that accept it (stock
	-- selection is cross-level too), nearest first. Distance is the one stock ranks simulation
	-- targets by (simulation_objects.sim_dist_to: game-graph points, comparable across levels).
	local sites = {}
	local current = squad.smart_id and SIMBOARD.smarts[squad.smart_id]
	for smart_id, entry in pairs(SIMBOARD.smarts) do
		local smart = entry.smrt
		if smart and smart_id ~= squad.smart_id and smart.locked ~= true and may_accept(smart, entry, squad) and
			precondition(smart, squad) then
			sites[#sites + 1] = {smart = smart, distance = simulation_objects.sim_dist_to(smart, squad)}
		end
	end
	table.sort(sites, function(a, b) return a.distance < b.distance end)
	if current and current.smrt then
		table.insert(sites, 1, {smart = current.smrt, distance = simulation_objects.sim_dist_to(current.smrt, squad)})
	end

	local sightings = {}
	for id, other in pairs(SIMBOARD.squads) do
		if id ~= group_id then
			local distance = squad.position:distance_to(other.position)
			if distance <= SIGHT_RADIUS_M then
				local seen = describe(other)
				if seen and seen.level_id == group.level_id then
					sightings[#sightings + 1] = {group = seen, distance = distance}
				end
			end
		end
	end
	table.sort(sightings, function(a, b) return a.distance < b.distance end)

	local hours = level.get_time_hours()
	local lines = {
		"xrsim_freeplay_observation_v1",
		string.format("owner %s %s", owner_id, membership_revision),
		"situation " .. ((hours >= 6 and hours < 21) and "day" or "night"),
	}
	for i = 1, math.min(#sites, MAX_SITES) do
		local smart = sites[i].smart
		lines[#lines + 1] = string.format("site %s %d %s %d", smart:name(), math.max(0, round(sites[i].distance)), site_kind(smart),
			SIMBOARD:get_smart_population(smart) or 0)
	end
	for i = 1, math.min(#sightings, MAX_SIGHTINGS) do
		local seen = sightings[i].group
		lines[#lines + 1] = string.format("sighting %s %s %s %d %d %s", seen.squad:name(), seen.species,
			seen.squad.player_id, #seen.members, round(sightings[i].distance),
			relation_between(group.species, group.community, seen.species, seen.community))
	end
	lines[#lines + 1] = "end"

	local ok, text = call("ai.freeplay.observe", table.concat(lines, "\n"))
	if not ok then
		warn_once("observe:" .. text, "observe refused: " .. text)
	end
end

------------------------------------------------------------------------------------------------
-- callbacks
------------------------------------------------------------------------------------------------

local function tick(now)
	local ok, text = call("ai.freeplay.tick", string.format("%d", now))
	if not ok then
		warn_once("tick:" .. text, "tick refused: " .. text)
		return
	end
	for line in string.gmatch(text, "[^\n]+") do
		local owner_id, binding, binding_id, revision = string.match(line, "^observe (%d+) (%a+) (%d+) (%d+)$")
		if owner_id then
			if binding == "group" then
				observe(owner_id, tonumber(binding_id), revision)
			end
		else
			local owner, group_id, rev, verb, site = string.match(line, "^apply (%d+) (%d+) (%d+) (%S+) (%S+) %S+$")
			if owner then
				local id, revision = tonumber(group_id), tonumber(rev)
				local known = objectives[id]
				-- Keyed on owner and revision: a group id reused by a new owner replaces the objective
				-- even at an equal revision, with fresh once-per-revision state.
				if not (known and known.owner == owner and known.rev == revision) then
					local objective = {owner = owner, rev = revision, verb = verb, site = site}
					-- arrived is never reported for a stay or a hold, nor when the squad already stays at the
					-- site by stock's action state (current_action == 1, stays_at) when the revision arrives;
					-- a squad at its smart with another action state can still report it without travel.
					local squad = SIMBOARD.squads[id]
					objective.no_arrival = verb == "stay" or is_hold(objective) or
						(squad ~= nil and stays_at(squad, site))
					objectives[id] = objective
				end
			else
				warn_once("line:" .. line, "unknown tick line: " .. line)
			end
		end
	end
end

local deactivate   -- defined with the registration helpers below

-- The installed get_squad_target: the objective's smart for a held squad, the stock function
-- with the caller's arguments for everyone else. An error switches the adapter off (which puts
-- the stock function back) and the call is answered by stock.
local function wrapped_get_squad_target(board, squad, ...)
	local stock = stock_target_fn
	if active and not failed then
		local ok, held, target = pcall(function()
			local objective = objectives[squad.id]
			if objective and holds(squad) then
				return true, objective_target(squad, objective)
			end
			return false
		end)
		if not ok then
			deactivate("! xrsim_freeplay: lua error in get_squad_target: " .. tostring(held))
		elseif held then
			return target
		end
	end
	return stock(board, squad, ...)
end

-- nil when stock target selection is not where the adapter expects it.
local function stock_board_class()
	local class = type(sim_board) == "table" and sim_board.simulation_board
	if class and type(class.get_squad_target) == "function" then
		return class
	end
	return nil
end

-- True for a function defined in this script (a wrapper left by an earlier load of it, e.g. when
-- the Lua state survives a load with -keep_lua).
local function from_this_script(fn)
	local dbg = rawget(_G, "debug")
	if not (dbg and dbg.getinfo) then
		return false
	end
	local ok, info = pcall(dbg.getinfo, fn, "S")
	return ok and info ~= nil and type(info.source) == "string" and
		string.find(info.source, "xrsim_freeplay", 1, true) ~= nil
end

-- The stock function behind the class field: the field itself, or the original an earlier
-- wrapper from this script captured (its stock_target_fn upvalue). nil when that cannot be found.
local function stock_behind(fn)
	if not from_this_script(fn) then
		return fn
	end
	local dbg = rawget(_G, "debug")
	if not (dbg and dbg.getupvalue) then
		return nil
	end
	for i = 1, 255 do
		local name, value = dbg.getupvalue(fn, i)
		if name == nil then
			break
		end
		if name == "stock_target_fn" then
			if type(value) == "function" and not from_this_script(value) then
				return value
			end
			return nil
		end
	end
	return nil
end

-- Class-level: the existing SIMBOARD instance resolves its methods through the class. stock is
-- stock_behind(class.get_squad_target), so a wrapper is never captured as "stock".
local function install_wrapper(class, stock)
	board_class = class
	stock_target_fn = stock
	wrapper_fn = wrapped_get_squad_target
	class.get_squad_target = wrapper_fn
end

-- Puts the stock function back unless something replaced the wrapper since; returns a word for
-- the log line.
local function restore_stock()
	if not board_class then
		return "not installed"
	end
	local result = "restored"
	if board_class.get_squad_target == wrapper_fn then
		board_class.get_squad_target = stock_target_fn
	else
		result = "replaced by another script, left as is"
	end
	board_class = nil
	wrapper_fn = nil
	return result
end

local function on_actor_update()
	local now = time_global()
	if now < next_tick then
		return
	end
	next_tick = now + TICK_MS
	if now >= next_sync then
		-- The engine can be switched off mid-session (ai.freeplay.mode off): then the adapter
		-- hands target selection back to stock.
		local _, current = call("ai.freeplay.mode", "")
		if current == "mode=off" then
			deactivate("xrsim_freeplay: engine mode is off, adapter stopped")
			return
		end
		local notice, reason = failure_notice(current, failures_shown)
		if notice then
			emit("~ xrsim_freeplay: provider failure " .. reason .. ": " .. notice)
			SetHudMsg(notice, 10)
		end
	end
	scan_lone_step(now)
	if now >= next_sync or (force_sync and now - last_sync >= FORCED_SYNC_GAP_MS) then
		sync(now)
	end
	tick(now)
end

local function on_first_update()
	local class = stock_board_class()
	local stock = class and stock_behind(class.get_squad_target)
	if not stock then
		failed = true
		local reason = class and
			"get_squad_target is wrapped by an earlier adapter load and its stock original is lost, adapter stays off" or
			"stock sim_board.simulation_board.get_squad_target not found, adapter stays off"
		emit("! xrsim_freeplay: " .. reason)
		SetHudMsg("xrsim_freeplay: " .. reason, 10)
		return false
	end
	local ok, text = call("ai.freeplay.mode", mode)
	if not ok then
		failed = true
		local sentence = refusal_message(text)
		emit("! xrsim_freeplay: " .. text .. " - " .. sentence)
		SetHudMsg(sentence, 10)
		return false
	end
	local began, epoch = call("ai.freeplay.begin", "")
	if not began then
		failed = true
		emit("! xrsim_freeplay: " .. epoch)
		SetHudMsg("xrsim_freeplay: " .. epoch, 10)
		return false
	end
	install_wrapper(class, stock)
	local activated = activation_message(text)
	log_info(activated .. " (" .. text .. " " .. epoch .. ")")
	SetHudMsg(activated, 10)
	active = true
	local now = time_global()
	scan_lone_full(now)
	sync(now)
	next_tick = now + TICK_MS
	return true
end

-- Stock fires squad_on_update inside sim_squad_scripted:update right before it runs
-- generic_update for a squad without a script target, so a reset made here is acted on in the
-- same update.
local function on_squad_update(squad)
	local objective = objectives[squad.id]
	if not (objective and holds(squad)) then
		return
	end
	local id = squad.id

	-- A new revision: once, make stock generic_update skip its keep-current-target branch and go
	-- straight to "Find a new target" (sim_squad_scripted.script generic_update): that branch runs
	-- only while current_action is set, and __lock makes the update return before it. Nothing is
	-- reset when the squad already targets the objective's smart (no churn for an unchanged stay or
	-- for a hold, which keeps the assigned smart).
	if objective.reset_rev ~= objective.rev then
		objective.reset_rev = objective.rev
		local wanted
		if is_hold(objective) then
			wanted = squad.smart_id
		else
			local smart = SIMBOARD.smarts_by_names[objective.site]
			wanted = smart and smart.id
		end
		if not (wanted ~= nil and squad.current_action ~= nil and squad.assigned_target_id == wanted) then
			squad.current_action = nil
			squad.__lock = nil
			held_locks[id] = nil
		end
	end

	if not objective.no_arrival and objective.arrived_rev ~= objective.rev and stays_at(squad, objective.site) then
		objective.arrived_rev = objective.rev
		call("ai.freeplay.event", id .. " arrived " .. objective.site)
	end
end

local function on_squad_unregister(squad)
	local id = squad.id
	call("ai.freeplay.retire", tostring(id))
	objectives[id] = nil
	held_locks[id] = nil
	enrolled[id] = nil
	sight_pairs[id] = nil
	script_picks[id] = nil
end

local function on_squad_npc_death(squad, npc)
	local npc_id = npc and (type(npc.id) == "function" and npc:id() or npc.id)
	if enrolled[squad.id] and npc_id then
		call("ai.freeplay.event", squad.id .. " casualty " .. npc_id)
	end
	-- Membership changed: sync soon, but deaths in a fight share one sync (see on_actor_update).
	force_sync = true
end

------------------------------------------------------------------------------------------------
-- registration
------------------------------------------------------------------------------------------------

local function unregister_all()
	for name, fn in pairs(registered) do
		UnregisterScriptCallback(name, fn)
	end
	registered = {}
end

-- Switches the adapter off for the session: puts stock target selection back, clears __lock on
-- the squads the wrapper's nil answers left locked (each in its own pcall, so one broken squad
-- cannot keep the others locked), forgets all objectives and unregisters the callbacks. Not
-- undone: targets stock assigned from the wrapper's answers (squads finish that travel, then
-- choose the stock way) and the one-time resets (stock sets those fields again itself).
deactivate = function(line)
	failed = true
	active = false
	local ok, restored = pcall(restore_stock)
	local unlocked = 0
	for id in pairs(held_locks) do
		pcall(function()
			local squad = (SIMBOARD and SIMBOARD.squads and SIMBOARD.squads[id]) or alife_object(id)
			if squad and squad.__lock then
				squad.__lock = nil
				unlocked = unlocked + 1
			end
		end)
	end
	held_locks = {}
	objectives = {}
	unregister_all()
	emit(line .. " (stock target selection " .. (ok and restored or "restore failed: " .. tostring(restored)) ..
		", unlocked " .. unlocked .. " squads)")
end

-- A Lua error in a callback is logged once and switches the adapter off for the session,
-- so it never repeats every frame.
local function guarded(name, body, needs_active)
	return function(...)
		if failed or (needs_active and not active) then
			return
		end
		local ok, result = pcall(body, ...)
		if not ok then
			deactivate("! xrsim_freeplay: lua error in " .. name .. ": " .. tostring(result))
		elseif result == false then
			unregister_all()
		end
	end
end

local function register(name, body, needs_active)
	local fn = guarded(name, body, needs_active)
	registered[name] = fn
	RegisterScriptCallback(name, fn)
end

function on_game_start()
	local requested = string.match(command_line() or "", "%-xrsim_freeplay%s+(%a+)")
	if not requested then
		return
	end
	verb_fn = rawget(_G, "xrsim_verb")
	if type(verb_fn) ~= "function" then
		emit("! xrsim_freeplay: xrsim_verb is not available, adapter stays off")
		return
	end
	mode = requested
	register("actor_on_first_update", on_first_update, false)
	register("actor_on_update", on_actor_update, true)
	register("squad_on_update", on_squad_update, true)
	register("squad_on_unregister", on_squad_unregister, true)
	register("squad_on_npc_death", on_squad_npc_death, true)
end
